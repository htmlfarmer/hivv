# .secret-guard-suppress — regex SUPPRESSIONS for the machine-wide guard hook
# (~/.git-hooks/pre-push). Read by the generic hook; each line is a POSIX ERE
# matched against the whole hit string ("<sha>:<path>:<line>:<content>").
#
# WHY THIS FILE EXISTS (separate from .secret-guard-ignore)
#   The generic hook's credential regex is deliberately broad:
#     (password|secret|token|api_key…)[A-Za-z0-9_-]*['"]?\s*[:=]\s*['"]?[A-Za-z0-9+_./=:-]{12,}
#   In a codebase that says "max_tokens", "input_tokens", "total_tokens"
#   several hundred times, that matches constantly — and a match BLOCKS the
#   push. `.secret-guard-ignore` cannot fix that: it is `file:line` form,
#   and the hook feeds every one of its lines to `grep -E` as a pattern. A
#   line like `key_pool: []` is an UNBALANCED bracket in ERE, so grep aborts
#   with "Unmatched [" and the whole allowlist silently stops applying.
#   Two formats, two files. The hook validates each pattern and drops only
#   the invalid ones.
#
# THE RULE — a suppression hides a SHAPE, never a VALUE.
#   Every pattern below matches a variable name, an env read, a header name,
#   a token COUNT field, a runtime-generated secret, or a known fake fixture.
#   None of them matches a real credential shape:
#     sk-…, sk-ant-…, ghp_…, github_pat_…, AKIA…, AIza…, eyJ…,
#     -----BEGIN … PRIVATE KEY-----, a 64-hex key, a postgres:// user:pw@ URL.
#   Those are caught by the hook's high-signal patterns and by this repo's
#   own scripts/scan_secrets.py, and NOTHING here suppresses them.
#
# Keep each pattern TIGHT. A loose one would also hide a real key on that
# path — which is the one mistake this file must never make.

# ── env reads: the value is never in the file ─────────────────────────────
process\.env\.HIVV_[A-Z_]+
process\.env\.LYRZ_API_KEY
process\.env\.NODE_TOKEN
process\.env\.NODE_SECRET
process\.env\.REDIS_PASSWORD
process\.env\.DB_PASSWORD
os\.environ\.get\(.HIVV_[A-Z_]+
os\.environ\.get\(.NODE_[A-Z_]+
HIVV_CONTROL_TOKEN\s*[:=]\s*process\.env
HIVV_SESSION_SECRET\s*[:=]\s*process\.env
HIVV_DB_PASSWORD\s*[:=]\s*process\.env
HIVV_ENCRYPTION_KEY\s*[:=]\s*process\.env
CONTROL_TOKEN\s*=\s*_loadControlToken\(\)
DIAL_SECRET\s*=\s*crypto\.randomBytes

# ── token-COUNT fields (not credentials) ──────────────────────────────────
["']?(input|output|total|max|final|safe|default|tokens_per_sec|shared)[a-z_]*tokens[a-z_]*["']?\s*[:=]\s*
tokens_per_sec\s*[:=]
tokens_served\s*=
prompt_tokens\s*[:=]
completion_tokens\s*[:=]
cost_in_per_1k|cost_out_per_1k|cost_per_1k
shared\.api_key_id
total_input_tokens|total_output_tokens|total_tokens_used
total_tokens_processed
tokensPerSec\s*[:=]
maxThinkingTokens

# ── session-token plumbing: a cookie/header NAME, never a value ───────────
X-Session-Token
hivv_session_token
x-node-secret
X-Agent-Token
x-session-token
req\.signedCookies
signedCookies\?\.hivv_session
localStorage\.getItem\(.[a-z_]*session_token
headers\[.X-Session-Token.\]
generateCSRFToken|generateSecureToken|csrfTokens\.get
_get_or_create_auth_token

# ── runtime-generated secrets: generated in-process, never committed ───────
crypto\.randomBytes\(
crypto\.randomUUID\(
randomBytes\(24\)\.toString\(
randomBytes\(32\)\.toString\(
randomBytes\(16\)\.toString\(

# ── shell / psql wiring: env-var reads and placeholders ───────────────────
DB_PASSWORD=.?\$HIVV_DB_PASSWORD
DB_PASSWORD=.?\$\{HIVV_DB_PASSWORD
PG_PASSWORD.*os\.environ\.get
BLNQ_ADMIN_TOKEN.*os\.environ\.get
hivv-prod-secret-\$\(date
HIVV_API_KEY=.?\$\{1:-\}

# ── deliberate test fixtures (fake, never sent anywhere) ──────────────────
CorrectHorse!Battery9
FAKE_SECRET|not-the-secret|not-needed|public-spectator
parity-secret-0123456789
USER-OWN-KEY
my-secret-token
secret_hash_abc123
sk-test-not-a-real-key
e2e-node-secret-fixed-0123456789
ghp_abcdefghijklmnopqrstuvwxyz0123456789

# ── the scanner's OWN pattern fixtures ─────────────────────────────────────
# tests/test_scan_secrets.py and scripts/scan_secrets.py contain the
# credential SHAPES the scanner looks for, spelled out so the detector can
# be pinned. A shape in a detector is not a credential in a program.
# (The scanner itself already ignores these files via .secret-guard-ignore.)
