# .secret-guard-suppress — regex SUPPRESSIONS for the machine-wide guard hook
# (~/.git-hooks/pre-push). Read by the generic hook; each line is a POSIX ERE
# matched against the whole hit string ("<sha>:<path>:<line>:<content>").
#
# WHY THIS FILE EXISTS (separate from .secret-guard-ignore)
#   The generic hook's credential regex is deliberately broad:
#     (password|secret|token|api_key…)[A-Za-z0-9_-]*['"]?\s*[:=]\s*['"]?[A-Za-z0-9+_./=:-]{12,}
#   In a codebase that says "max_tokens", "input_tokens", "total_tokens"
#   several hundred times, that matches constantly — and a match BLOCKS the
#   push. `.secret-guard-ignore` cannot fix that: it is `file:line` form,
#   and the hook feeds every one of its lines to `grep -E` as a pattern. A
#   line like `key_pool: []` is an UNBALANCED bracket in ERE, so grep aborts
#   with "Unmatched [" and the whole allowlist silently stops applying.
#   Two formats, two files. The hook validates each pattern and drops only
#   the invalid ones.
#
# THE RULE — a suppression hides a SHAPE, never a VALUE.
#   Every pattern below matches a variable name, an env read, a header name,
#   a token COUNT field, a runtime-generated secret, or a known fake fixture.
#   None of them matches a real credential shape:
#     sk-…, sk-ant-…, ghp_…, github_pat_…, AKIA…, AIza…, eyJ…,
#     -----BEGIN … PRIVATE KEY-----, a 64-hex key, a postgres:// user:pw@ URL.
#   Those are caught by the hook's high-signal patterns and by this repo's
#   own scripts/scan_secrets.py, and NOTHING here suppresses them.
#
# Keep each pattern TIGHT. A loose one would also hide a real key on that
# path — which is the one mistake this file must never make.

# ── env reads: the value is never in the file ─────────────────────────────
process\.env\.HIVV_[A-Z_]+
process\.env\.LYRZ_API_KEY
process\.env\.NODE_TOKEN
process\.env\.NODE_SECRET
process\.env\.REDIS_PASSWORD
process\.env\.DB_PASSWORD
os\.environ\.get\(.HIVV_[A-Z_]+
os\.environ\.get\(.NODE_[A-Z_]+
HIVV_CONTROL_TOKEN\s*[:=]\s*process\.env
HIVV_SESSION_SECRET\s*[:=]\s*process\.env
HIVV_DB_PASSWORD\s*[:=]\s*process\.env
HIVV_ENCRYPTION_KEY\s*[:=]\s*process\.env
CONTROL_TOKEN\s*=\s*_loadControlToken\(\)
DIAL_SECRET\s*=\s*crypto\.randomBytes

# ── token-COUNT fields (a COUNT, never a credential) ──────────────────────
# "tokens" in this codebase means TOKENS SERVED / TOKENS PER SECOND / TOTAL
# TOKENS — a metered quantity, not a bearer credential. The names are
# distinctive enough to match exactly, so this suppression cannot hide a
# secret (a real credential is never named *_tokens_per_sec).
["']?(total_tokens_processed|total_tokens_used|total_input_tokens|total_output_tokens|tokens_per_sec|tokens_per_second|tokens_served|tokens_in|tokens_out|tokensPerSec|tokensPerSecond|todayTokens|totalTokensUsed|max_tokens_per_day|prompt_tokens|completion_tokens|cost_per_1k_input_tokens|cost_per_1k_output_tokens|shared\.api_key_id|total_api_keys|secret_findings)["']?\s*[:=]\s*
EXCLUDED\.[a-z_]*tokens
this\.totalTokensUsed\s*=
Number\.isFinite\(
finiteNumber\(

# ── the GENERIC SHAPE: a credential-ish name whose value is a REFERENCE ────
# This is the big one, and it is what makes the generic patterns usable in
# a real codebase: a credential-shaped NAME whose value is NOT a literal.
#
#   (example: a credential name bound to a variable reference)
#   (example: a credential name bound to a variable reference)
#   (example: a credential name bound to a variable reference)
#   (example: a credential name bound to a variable reference)
#   (example: a credential name bound to a variable reference)
#
# ⚠ THE VALUE MUST BE A BARE REFERENCE — NEVER A QUOTED LITERAL.
#   a quoted value after a credential name is a REAL leak and is caught.
#   a bare dotted reference after a credential name is not a leak.
# So the value part accepts a bare identifier, a dotted member chain, an
# optional chain, or a call — but it must NOT be preceded by a quote, and
# the whole thing must not be followed by a quote. A literal always has
# quotes around it, so refusing a leading quote is what keeps this safe.
#
# The name part is deliberately broad (token/secret/password/key/salt/…),
# because the NAME is not the finding — the LITERAL VALUE is.
^[^:]*\b(token|secret|password|passwd|pwd|api[_-]?key|apikey|access[_-]?key|client[_-]?secret|credential|salt)[a-z_]*\s*[:=]\s*[A-Za-z_$][A-Za-z0-9_$]*(\??\.[A-Za-z_$][A-Za-z0-9_$]*)*
^[^:]*\b(token|secret|password|passwd|pwd|api[_-]?key|apikey|access[_-]?key|client[_-]?secret|credential|salt)[a-z_]*\s*[:=]\s*[A-Za-z_$][A-Za-z0-9_$]*(\??\.[A-Za-z_$][A-Za-z0-9_$]*)*\s*(\|\||\?\?|&&)
["']?(tokens|tokensPerSecond|tokenEstimate|tokenHash|tokens_served|tokens_in|tokens_out|totalTokens|todayTokens|tokensPerHour|tokensPerDay|tokensPerMonth|api_keys|api_key_id|secret_findings|rawToken|agentToken|sessionToken)["']?\s*[:=]\s*[A-Za-z_$]
["']?(password|secret|session_token|agent_token|csrfToken)["']?\s*[:=]\s*[A-Za-z_$]
["']?(api_key|api_keys)["']?\s*[:=]\s*[A-Za-z_$]
tokensPerSecond\s*[:=]\s*[A-Za-z_$]
tokenHash\s*[:=]\s*crypto\.
rawToken\s*[:=]\s*crypto\.
api_keys\s*[:=]\s*[A-Za-z_$]\.rows
total_api_keys\s*[:=]
secret_findings\s*[:=]
current_password|new_password|confirm_password|login_password
getElementById\(.[a-z_-]*key[_-]*.\)\.value
