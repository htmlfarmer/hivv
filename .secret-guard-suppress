# ── the scanner's OWN pattern fixtures (PATH-SCOPED) ──────────────────────
# tests/test_scan_secrets.py and scripts/scan_secrets.py contain the
# credential SHAPES the scanner looks for, spelled out so the detector can
# be pinned. A shape in a DETECTOR is not a credential in a program.
#
# ⚠ These MUST be path-scoped, and the path must be REQUIRED (no optional
# prefix). An optional "(.*/)?" would make the pattern match ANY path —
# which is exactly how a real leaked key got hidden during testing. The
# hit string is "<sha>:<path>:<line>:<content>", so the path is anchored
# after the sha and a colon.
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*sk-(live|test|proj)-
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*BEGIN (RSA PRIVATE KEY|OPENSSH PRIVATE KEY|EC PRIVATE KEY|DSA PRIVATE KEY|PRIVATE KEY)
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*xox[baprs]-
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*AKIA[0-9A-Z]{16}
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*ASIA[0-9A-Z]{16}
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*AIza[0-9A-Za-z_-]{35}
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*sk-ant-[A-Za-z0-9\-]{20,}
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*ghp_[A-Za-z0-9]{36}
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*github_pat_[A-Za-z0-9_]{22,}
[0-9a-f]{40}:.*scripts/scan_secrets\.py:.*gh[ourps]_[A-Za-z0-9]{36}
[0-9a-f]{40}:.*tests/test_scan_secrets\.py:.*sk-(live|test|proj)-
[0-9a-f]{40}:.*tests/test_scan_secrets\.py:.*BEGIN (RSA PRIVATE KEY|OPENSSH PRIVATE KEY|EC PRIVATE KEY|DSA PRIVATE KEY|PRIVATE KEY)
