# ── the two remaining reference shapes ────────────────────────────────────
#   (example: a credential name bound to a variable reference)
# — the value is a member access or a method call on a variable.
# (No path anchor: these shapes are specific enough — a credential-shaped
# name whose value is a bare member access is a reference, never a secret.)
[[:space:]]token:[[:space:]]*[A-Za-z_$][A-Za-z0-9_$]*(\??\.[A-Za-z_$][A-Za-z0-9_$]*)+
[[:space:]](const|let|var)[[:space:]]+[a-z_]*token[a-z_]*[[:space:]]*=[[:space:]]*[A-Za-z_$][A-Za-z0-9_$]*\.

